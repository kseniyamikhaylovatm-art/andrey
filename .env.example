# Optional: a Miro OAuth access token with boards:read, installed in the board team.
MIRO_ACCESS_TOKEN=
# Optional locally. Required to enable Claude features.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Teacher's personal code, at least 16 characters. Never share it with a student.
TEACHER_ACCESS_CODE=
# Legacy code: opens only the existing Andrey and Tanya student space.
# New students receive generated codes in the teacher dashboard.
APP_ACCESS_CODE=
# Required in production: at least 32 characters.
SESSION_SECRET=
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Enable only for a trial server with temporary storage.
DEMO_MODE=false
